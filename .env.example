# astro-ingest configuration. Copy to .env (never commit .env).
# Dev values shown; production uses ASTRO_ROOT=/astro with the archive mounted read-write.

# Where the app writes (the archive root it files into). In dev this MUST be the sandbox.
ASTRO_ROOT=/astro-sandbox
# The real archive, read-only, used for lookups (already-archived checks, calibration library index).
ASTRO_ARCHIVE=/astro
# App state (SQLite, batch exports, operation logs). Lives on the share so Claude sessions see the same state.
STATE_DIR=/astro-sandbox/Z95-ClaudeReferences/ingest
# Site time zone: used to convert FITS DATE-OBS (UTC) to local time.
TZ=America/New_York

# ASIAIR source. Leave ASIAIR_ROOT empty to talk SMB directly (discovery on ASIAIR_SUBNET, or ASIAIR_HOST if set).
# Set ASIAIR_ROOT to a local directory to use it as the source instead (dev: the sandbox sample or a scratch copy).
ASIAIR_ROOT=/astro-sandbox/_asiair-sample
ASIAIR_SUBNET=192.168.1.0/24
ASIAIR_SHARE=EMMC Images
ASIAIR_HOST=
