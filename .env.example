# astro-ingest configuration. Copy to .env (never commit .env).
# Dev values shown; production uses ASTRO_ROOT=/astro with the Astronomy share mounted read-write.

# Where the app writes (the share root it ingests into). In dev this MUST be the sandbox.
ASTRO_ROOT=/astro-sandbox
# The live Astronomy share on the NAS, read-only, for lookups (already-ingested checks, calibration library index).
# (Older .env files call this ASTRO_ARCHIVE; that name is still accepted.)
ASTRO_NAS=/astro
# App state (SQLite, batch exports, operation logs). Lives on the share so Claude sessions see the same state.
STATE_DIR=/astro-sandbox/Z95-ClaudeReferences/ingest
# Disposable renders (frame thumbnails, lightbox previews). Safe to delete. Default: $STATE_DIR/cache
CACHE_DIR=
# Staging: every selected frame is read from the device once, into here, and scored/filed from here.
# Production: a separate UnRAID share (e.g. /mnt/user/astro-staging mounted at /staging). Default: $ASTRO_ROOT/_staging
STAGING_DIR=
# Rough transfer estimate on the Select step until a staging run has measured the real rate (MB/s; Wi-Fi ~10)
ASSUMED_WIFI_MB_S=10
# Site time zone: used to convert FITS DATE-OBS (UTC) to local time.
TZ=America/New_York

# ASIAIR source. Leave ASIAIR_ROOT empty to talk SMB directly (discovery on ASIAIR_SUBNET, or ASIAIR_HOST if set).
# Set ASIAIR_ROOT to a local directory to use it as the source instead (dev: the sandbox sample or a scratch copy).
ASIAIR_ROOT=/astro-sandbox/_asiair-sample
ASIAIR_SUBNET=192.168.1.0/24
ASIAIR_SHARE=EMMC Images
ASIAIR_HOST=
